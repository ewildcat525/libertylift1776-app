# Supabase Configuration
# Get these from your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical site URL used for metadata, OG images, and the sitemap.
# Set this to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Community chat contains public user-generated content and is disabled unless
# explicitly enabled. Production also requires the matching database feature
# flag described in README.md.
NEXT_PUBLIC_ENABLE_COMMUNITY_CHAT=false
NEXT_PUBLIC_ENABLE_PUBLIC_CONTESTS=false

# Public support address shown in the app and required for App Store support.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# Apple Developer Team ID used by the universal-link association response.
APPLE_TEAM_ID=YOUR10CHARTEAMID

# --- Email reminder pipeline (server-only; required in production) ---
# Service role key from Supabase: Settings -> API. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) API key and verified sender.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Liberty Lift 1776 <hello@yourdomain.com>"

# A single address used by the protected /api/email/test endpoint.
EMAIL_TEST_RECIPIENT=you@example.com

# Shared secret protecting the cron and email routes.
# Vercel sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string

# Signs the one-click unsubscribe link in every email. Never rotate it: links
# already in inboxes depend on it. Existing deployments should set it to the
# current CRON_SECRET value (which used to sign these links) so CRON_SECRET
# can be rotated freely afterwards. Falls back to CRON_SECRET when unset.
UNSUBSCRIBE_SECRET=generate-a-different-long-random-string
